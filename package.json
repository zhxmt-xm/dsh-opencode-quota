{
  "name": "dsh-opencode-usage-dashboard",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode Go 用量面板：在 DSH 侧栏查看订阅额度、花费与用量趋势。OpenCode Go quota, spend and usage dashboard for DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhxmt-xm/dsh-opencode-quota.git"
  },
  "homepage": "https://github.com/zhxmt-xm/dsh-opencode-quota#readme",
  "bugs": {
    "url": "https://github.com/zhxmt-xm/dsh-opencode-quota/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "opencode",
    "opencode-go",
    "quota",
    "usage",
    "dashboard",
    "sidebar"
  ],
  "scripts": {
    "start": "node start.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "start.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
