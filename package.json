{
  "name": "dsh-opencode-usage-dashboard",
  "version": "1.0.1",
  "type": "module",
  "description": "OpenCode 用量面板：在 DeepSeek Harness 侧栏查看 Go 订阅额度、Console 按量花费、用量趋势与月度预测。OpenCode quota, spend, usage and forecast dashboard for DeepSeek Harness.",
  "license": "MIT",
  "author": "zhxmt-xm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhxmt-xm/dsh-opencode-usage-dashboard.git"
  },
  "homepage": "https://github.com/zhxmt-xm/dsh-opencode-usage-dashboard#readme",
  "bugs": {
    "url": "https://github.com/zhxmt-xm/dsh-opencode-usage-dashboard/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "opencode",
    "opencode-go",
    "quota",
    "usage",
    "dashboard",
    "sidebar"
  ],
  "scripts": {
    "start": "node start.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "start.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
