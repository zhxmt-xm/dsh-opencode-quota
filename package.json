{
  "name": "@local/dsh-opencode-quota",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode Go 套餐额度面板：在左侧栏设置上方显示订阅额度与用量，并在设置里管理账户、展示与刷新。",
  "license": "MIT",
  "scripts": {
    "start": "node switch-source.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
